{
  "animation": {
    "show": {
      "$value": "show 300ms ease-in forwards"
    },
    "hide": {
      "$value": "hide 200ms ease-out forwards"
    }
  },
  "keyframes": {
    "$type": "number",
    "show": {
      "from": {
        "opacity": {
          "$value": 0
        }
      },
      "to": {
        "opacity": {
          "$value": 1
        }
      }
    },
    "hide": {
      "from": {
        "opacity": {
          "$value": 1
        }
      },
      "to": {
        "opacity": {
          "$value": 0
        }
      }
    }
  }
}
