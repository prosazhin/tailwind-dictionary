{
  "size": {
    "$type": "dimension",
    "16": { "$value": { "value": 16, "unit": "px" } },
    "48": { "$value": { "value": 3, "unit": "rem" } }
  },
  "color": {
    "$type": "color",
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "alpha": 0.5 } },
    "brand": { "$value": { "colorSpace": "oklch", "components": [0.62, 0.19, 259.8] } },
    "glass": { "$value": { "colorSpace": "display-p3", "components": [0, 0.5, 1], "alpha": 0.25 } },
    "none": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0 } },
    "string": { "$value": "#123456" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter Variable", "system-ui", "sans-serif"] },
      "mono": { "$value": "JetBrains Mono, monospace" }
    },
    "weight": { "$type": "fontWeight", "bold": { "$value": 700 } },
    "size": { "16": { "$value": "{size.16}" } },
    "h48": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{size.48}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": -0.5, "unit": "px" },
        "lineHeight": 1.2
      }
    },
    "body": {
      "$type": "typography",
      "$extensions": { "dev.prosazhin.mixin": "body-lg" },
      "$value": { "fontSize": "{size.16}", "lineHeight": 1.5, "fontWeight": 400 }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": [
        { "color": "{color.ink}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1, "hex": "#000000" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": -2, "unit": "px" }, "inset": true }
      ]
    },
    "legacy": { "$value": "0 1px 2px rgba(0, 0, 0, 0.1)" }
  },
  "screen": {
    "$type": "dimension",
    "sm": { "$value": { "value": 640, "unit": "px" } },
    "lg": {
      "min": { "$value": { "value": 1024, "unit": "px" } },
      "max": { "$value": { "value": 1439, "unit": "px" } }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 150, "unit": "ms" } }
  },
  "ease": {
    "$type": "cubicBezier",
    "out": { "$value": [0.2, 0, 0, 1] }
  },
  "animation": {
    "fade": { "$value": "fade 150ms ease-out" }
  },
  "keyframes": {
    "$type": "number",
    "fade": {
      "from": { "opacity": { "$value": 0 } },
      "to": { "opacity": { "$value": 1 } }
    }
  }
}
